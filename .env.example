# Copy to .env (local dev with `vercel dev`) and set the same values in
# Vercel -> Project -> Settings -> Environment Variables.

# Neon connection string (Neon dashboard -> Connect -> pooled connection)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=require

# Password for the /admin.html page
ADMIN_PASSWORD=change-me-to-a-long-passphrase

# Random string, 32+ characters, used to sign the admin session cookie
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ---- Owner alerts (optional; each channel works on its own) ----
# Email via Resend (resend.com). Sandbox sender only delivers to the Resend account owner's address.
RESEND_API_KEY=
ALERT_EMAIL_TO=
# Optional. Default: Sam's Logistics <onboarding@resend.dev>. Use your own once the domain is verified in Resend.
ALERT_EMAIL_FROM=
# WhatsApp via CallMeBot (callmebot.com). Phone in international format, e.g. 447XXXXXXXXX
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=
# Used for the admin link inside alerts. Default: https://samslogistics.co.uk
SITE_URL=
