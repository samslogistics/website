# Copy to .env (local dev with `vercel dev`) and set the same values in
# Vercel -> Project -> Settings -> Environment Variables.

# Neon connection string (Neon dashboard -> Connect -> pooled connection)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=require

# Password for the /admin.html page
ADMIN_PASSWORD=change-me-to-a-long-passphrase

# Random string, 32+ characters, used to sign the admin session cookie
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
